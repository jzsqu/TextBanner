<Window x:Class="TextBanner.UI.BannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        SizeToContent="Height"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnMouseLeftButtonUp"
        MouseRightButtonUp="OnMouseRightButtonUp">
    <Border x:Name="Card"
            Margin="8"
            Background="{DynamicResource Theme.Surface}"
            CornerRadius="14"
            BorderBrush="{DynamicResource Theme.Border}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="7" Opacity="0.30" Color="#0B1B3A" Direction="270"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="AccentBar" Grid.Column="0" Background="#2F6FED" CornerRadius="14,0,0,14"/>
            <StackPanel Grid.Column="1" Margin="18,14,18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText"
                               Grid.Column="0"
                               Text="触发提示"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#2F6FED"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <Button x:Name="CloseButton"
                            Grid.Column="1"
                            Content="✕"
                            Width="26" Height="26"
                            Margin="10,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource Theme.TextSecondary}"
                            FontSize="13"
                            Cursor="Hand"
                            Click="CloseButton_Click"/>
                </Grid>
                <ScrollViewer MaxHeight="320" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="MessageText"
                               FontSize="16"
                               Foreground="{DynamicResource Theme.Text}"
                               TextWrapping="Wrap"
                               LineHeight="24"/>
                </ScrollViewer>
                <TextBlock x:Name="HintText"
                           Text="双击设置 · 右键关闭 · 长按固定"
                           FontSize="11"
                           Foreground="{DynamicResource Theme.TextSecondary}"
                           Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
