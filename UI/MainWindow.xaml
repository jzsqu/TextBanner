<Window x:Class="TextBanner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextBanner — Settings"
        Width="940" Height="680"
        MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.WindowBg}"
        TextElement.Foreground="{DynamicResource Theme.Text}"
        Closing="OnClosing">
    <Window.Resources>
        <!-- ============ 基础控件主题（三色调简约） ============ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Theme.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Path Data="M 0 0 L 4 4 L 8 0"
                                                  Stroke="{DynamicResource Theme.TextSecondary}"
                                                  StrokeThickness="1.5"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,9,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,0,26,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource Theme.Surface}"
                                        BorderBrush="{DynamicResource Theme.Border}"
                                        BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Surface}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Margin="4,0,0,0"/>
                            </Border>
                            <Border Grid.Row="1"
                                    Background="{DynamicResource Theme.Surface}"
                                    BorderBrush="{DynamicResource Theme.Border}"
                                    BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,10,10"
                                    Padding="4">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="0,0,0,2">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Selected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource Theme.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <GridViewRowPresenter VerticalAlignment="Center" Columns="{TemplateBinding GridView.ColumnCollection}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Selected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource Theme.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
        </Style>

        <!-- ============ 文本样式 ============ -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
            <Setter Property="Margin" Value="0,20,0,6"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Theme.Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock x:Name="HeaderTitle" Text="TextBanner" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Theme.Text}" VerticalAlignment="Center"/>
            <TextBlock x:Name="HeaderSubtitle" Text="Floating banner · text-triggered" FontSize="12" Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center" Margin="8,3,0,0"/>
        </StackPanel>

        <TabControl x:Name="MainTabs" Grid.Row="1">
            <TabItem x:Name="TabRules" Header="Rules">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="BtnNew" Content="New" Style="{StaticResource PrimaryButton}" Click="AddRule_Click"/>
                            <Button x:Name="BtnDuplicate" Content="Duplicate" Margin="6,0,0,0" Click="DuplicateRule_Click"/>
                            <Button x:Name="BtnDelete" Content="Delete" Margin="6,0,0,0" Click="DeleteRule_Click"/>
                        </StackPanel>
                        <ListBox x:Name="RuleList"
                                 Grid.Row="1"
                                 SelectionChanged="RuleList_SelectionChanged"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,7">
                                        <TextBlock Text="{Binding Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="EditorPanel" Margin="10,4,10,16">
                            <TextBlock x:Name="SecBasic" Text="Basic info" Style="{StaticResource Section}"/>
                            <TextBlock x:Name="LblName" Text="Name" Style="{StaticResource Label}"/>
                            <TextBox x:Name="NameBox" TextChanged="Text_Changed"/>
                            <CheckBox x:Name="EnabledCheck" Content="Enabled" Margin="0,12,0,0" Click="EnabledCheck_Click"/>

                            <TextBlock x:Name="SecTrigger" Text="Trigger" Style="{StaticResource Section}"/>
                            <TextBlock x:Name="LblSource" Text="Source" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="SourceCombo" SelectionChanged="SourceCombo_SelectionChanged"/>

                            <TextBlock x:Name="MatchLabel" Text="Match text" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                            <TextBox x:Name="MatchBox" TextChanged="Text_Changed"/>
                            <TextBlock x:Name="HintMatch" Style="{StaticResource Hint}" Text="e.g. keyword"/>

                            <TextBlock x:Name="TargetLabel" Text="Match target" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                            <ComboBox x:Name="TargetCombo" SelectionChanged="TargetCombo_SelectionChanged"/>

                            <TextBlock x:Name="LblSourceFilter" Text="Source filter" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                            <TextBox x:Name="FilterBox" TextChanged="Text_Changed"/>
                            <TextBlock x:Name="FilterHint" Style="{StaticResource Hint}"/>

                            <TextBlock x:Name="SecDisplay" Text="Display" Style="{StaticResource Section}"/>
                            <TextBlock x:Name="LblDisplayText" Text="Display text (Markdown)" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                <Button x:Name="BtnBold" Content="B" Tag="bold" Click="FormatButton_Click" Width="30" Padding="0,4" Margin="0,0,4,0" FontWeight="Bold"/>
                                <Button x:Name="BtnItalic" Content="I" Tag="italic" Click="FormatButton_Click" Width="30" Padding="0,4" Margin="0,0,4,0" FontStyle="Italic"/>
                                <Button x:Name="BtnStrike" Content="S" Tag="strike" Click="FormatButton_Click" Width="30" Padding="0,4" Margin="0,0,4,0"/>
                                <Button x:Name="BtnCode" Content="`" Tag="code" Click="FormatButton_Click" Width="30" Padding="0,4" Margin="0,0,4,0"/>
                                <Button x:Name="BtnLink" Content="Link" Tag="link" Click="FormatButton_Click" Padding="8,4" Margin="0,0,4,0"/>
                                <Button x:Name="BtnHeading" Content="H" Tag="heading" Click="FormatButton_Click" Width="30" Padding="0,4" Margin="0,0,4,0" FontWeight="Bold"/>
                                <Button x:Name="BtnList" Content="•" Tag="list" Click="FormatButton_Click" Width="30" Padding="0,4" Margin="0,0,4,0"/>
                            </StackPanel>
                            <TextBox x:Name="DisplayBox"
                                     TextChanged="Text_Changed"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="76"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"/>
                            <TextBlock x:Name="HintMarkdown" Style="{StaticResource Hint}" Text="Supports **bold**"/>

                            <TextBlock x:Name="LblAction" Text="Open on trigger (optional)" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                            <TextBox x:Name="ActionBox" TextChanged="Text_Changed"/>
                            <TextBlock x:Name="HintAction" Style="{StaticResource Hint}" Text="Open URL/folder/file"/>

                            <TextBlock x:Name="LblDuration" Text="Duration (seconds)" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="DurationSlider" Grid.Column="0" Minimum="1" Maximum="120" ValueChanged="DurationSlider_ValueChanged" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="DurationBox" Grid.Column="1" Width="54" TextAlignment="Center" LostFocus="DurationBox_LostFocus" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DurationUnit" Grid.Column="2" Text="s" FontSize="13" VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock x:Name="LblSize" Text="Size" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                            <ComboBox x:Name="SizeCombo" SelectionChanged="SizeCombo_SelectionChanged"/>

                            <TextBlock x:Name="LblColor" Text="Banner color" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="ColorCombo" Width="150" SelectionChanged="ColorCombo_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Rectangle x:Name="ColorPreview" Width="22" Height="22" RadiusX="6" RadiusY="6" Margin="10,0,0,0" VerticalAlignment="Center" Stroke="{DynamicResource Theme.Border}"/>
                            </StackPanel>

                            <Button x:Name="BtnTest" Content="Test this rule" Margin="0,18,0,0" HorizontalAlignment="Left" Click="TestButton_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabEvents" Header="Events">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BtnClear" Content="Clear" Click="ClearEvents_Click"/>
                        <TextBlock x:Name="HintEvents" Text="Keeps the latest 500" FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <ListView x:Name="EventList" Grid.Row="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn x:Name="ColTime" Header="Time" Width="150" DisplayMemberBinding="{Binding Time, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                                <GridViewColumn x:Name="ColRule" Header="Rule" Width="160" DisplayMemberBinding="{Binding RuleName}"/>
                                <GridViewColumn x:Name="ColSource" Header="Source" Width="90" DisplayMemberBinding="{Binding Source}"/>
                                <GridViewColumn x:Name="ColMatch" Header="Matched" Width="440" DisplayMemberBinding="{Binding MatchedText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabGeneral" Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock x:Name="SecAppearance" Text="Appearance" Style="{StaticResource Section}"/>
                    <TextBlock x:Name="LblTheme" Text="Theme" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeCombo_SelectionChanged"/>
                    <TextBlock x:Name="HintTheme" Style="{StaticResource Hint}" Text="Light / Dark / Mint / Dusk / Crimson"/>

                    <TextBlock x:Name="LblLanguage" Text="Language" Style="{StaticResource Label}" Margin="0,16,0,4"/>
                    <ComboBox x:Name="LanguageCombo" SelectionChanged="LanguageCombo_SelectionChanged"/>

                    <TextBlock x:Name="LblPosition" Text="Banner position" Style="{StaticResource Label}" Margin="0,16,0,4"/>
                    <ComboBox x:Name="PositionCombo" SelectionChanged="PositionCombo_SelectionChanged"/>
                    <TextBlock x:Name="HintPosition" Style="{StaticResource Hint}" Text="Where banners appear"/>

                    <TextBlock x:Name="SecBehavior" Text="Behavior" Style="{StaticResource Section}"/>
                    <TextBlock x:Name="LblDefaultDuration" Text="Default duration (seconds)" Style="{StaticResource Label}"/>
                    <TextBox x:Name="DefaultDurationBox" LostFocus="DefaultDurationBox_LostFocus"/>

                    <TextBlock x:Name="LblPoll" Text="Poll interval (ms)" Style="{StaticResource Label}" Margin="0,16,0,4"/>
                    <ComboBox x:Name="PollCombo" SelectionChanged="PollCombo_SelectionChanged"/>

                    <TextBlock x:Name="LblCooldown" Text="Cooldown (seconds)" Style="{StaticResource Label}" Margin="0,16,0,4"/>
                    <TextBox x:Name="CooldownBox" LostFocus="CooldownBox_LostFocus"/>
                    <TextBlock x:Name="HintCooldown" Style="{StaticResource Hint}" Text="Minimum gap between two triggers"/>

                    <TextBlock x:Name="SecBrowser" Text="Browser detection" Style="{StaticResource Section}"/>
                    <TextBlock x:Name="LblBrowserProc" Text="Browser processes" Style="{StaticResource Label}"/>
                    <TextBox x:Name="BrowserProcessesBox" LostFocus="BrowserProcessesBox_LostFocus"/>
                    <TextBlock x:Name="HintBrowserProc" Style="{StaticResource Hint}" Text="Process names for the browser-tab source"/>

                    <TextBlock x:Name="LblCdp" Text="CDP debug port" Style="{StaticResource Label}" Margin="0,16,0,4"/>
                    <TextBox x:Name="CdpPortsBox" LostFocus="CdpPortsBox_LostFocus"/>
                    <TextBlock x:Name="HintCdp" Style="{StaticResource Hint}" Text="Launch the browser with --remote-debugging-port"/>
                    <TextBlock x:Name="CdpStatusText" FontSize="12" Foreground="{DynamicResource Theme.Accent}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                    <TextBlock x:Name="SecSystem" Text="System" Style="{StaticResource Section}"/>
                    <CheckBox x:Name="AutoStartCheck" Content="Start with Windows" Click="AutoStartCheck_Click"/>
                    <CheckBox x:Name="PausedCheck" Content="Pause all monitoring" Margin="0,10,0,0" Click="PausedCheck_Click"/>

                    <TextBlock x:Name="HintAutoSave" Margin="0,22,0,0" FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}" TextWrapping="Wrap"
                               Text="Config auto-saves"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
