<Window x:Class="TextBanner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文本触发提醒 — 设置"
        Width="940" Height="680"
        MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.WindowBg}"
        TextElement.Foreground="{DynamicResource Theme.Text}"
        Closing="OnClosing">
    <Window.Resources>
        <!-- ============ 基础控件主题（三色调简约） ============ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Theme.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Path Data="M 0 0 L 4 4 L 8 0"
                                                  Stroke="{DynamicResource Theme.TextSecondary}"
                                                  StrokeThickness="1.5"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,9,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,0,26,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource Theme.Surface}"
                                        BorderBrush="{DynamicResource Theme.Border}"
                                        BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Surface}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Margin="4,0,0,0"/>
                            </Border>
                            <Border Grid.Row="1"
                                    Background="{DynamicResource Theme.Surface}"
                                    BorderBrush="{DynamicResource Theme.Border}"
                                    BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,10,10"
                                    Padding="4">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="0,0,0,2">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Selected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource Theme.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <GridViewRowPresenter VerticalAlignment="Center" Columns="{TemplateBinding GridView.ColumnCollection}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Selected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource Theme.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
        </Style>

        <!-- ============ 文本样式 ============ -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
            <Setter Property="Margin" Value="0,20,0,6"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Theme.Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="文本触发提醒" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Theme.Text}" VerticalAlignment="Center"/>
            <TextBlock Text="  悬浮提示栏 · 基于文本触发" FontSize="12" Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center" Margin="8,3,0,0"/>
        </StackPanel>

        <TabControl x:Name="MainTabs" Grid.Row="1">
            <TabItem Header="规则">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="＋ 新建" Style="{StaticResource PrimaryButton}" Click="AddRule_Click"/>
                            <Button Content="复制" Margin="6,0,0,0" Click="DuplicateRule_Click"/>
                            <Button Content="删除" Margin="6,0,0,0" Click="DeleteRule_Click"/>
                        </StackPanel>
                        <ListBox x:Name="RuleList"
                                 Grid.Row="1"
                                 SelectionChanged="RuleList_SelectionChanged"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,7">
                                        <TextBlock Text="{Binding Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="EditorPanel" Margin="10,4,10,16">
                            <TextBlock Text="基本信息" Style="{StaticResource Section}"/>
                            <TextBlock Text="规则名称" Style="{StaticResource Label}"/>
                            <TextBox x:Name="NameBox" TextChanged="Text_Changed"/>
                            <CheckBox x:Name="EnabledCheck" Content="启用此规则" Margin="0,12,0,0" Click="EnabledCheck_Click"/>

                            <TextBlock Text="触发条件" Style="{StaticResource Section}"/>
                            <TextBlock Text="触发来源" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="SourceCombo" SelectionChanged="SourceCombo_SelectionChanged"/>

                            <TextBlock x:Name="MatchLabel" Text="匹配文本（标题 / 内容中包含，多个用 | 或 ; 分隔）" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                            <TextBox x:Name="MatchBox" TextChanged="Text_Changed"/>
                            <TextBlock Style="{StaticResource Hint}" Text="例如：关键词，或多个用 | 或 ; 分隔（任一命中即触发，不区分大小写）"/>

                            <TextBlock x:Name="TargetLabel" Text="匹配目标" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                            <ComboBox x:Name="TargetCombo" SelectionChanged="TargetCombo_SelectionChanged"/>

                            <TextBlock Text="来源限定" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                            <TextBox x:Name="FilterBox" TextChanged="Text_Changed"/>
                            <TextBlock x:Name="FilterHint" Style="{StaticResource Hint}"/>

                            <TextBlock Text="显示效果" Style="{StaticResource Section}"/>
                            <TextBlock Text="显示文本（支持 Markdown，可叠加样式）" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                <Button Content="B" Tag="bold" Click="FormatButton_Click" Width="30" Padding="0,4" Margin="0,0,4,0" FontWeight="Bold" ToolTip="加粗 **文字**"/>
                                <Button Content="I" Tag="italic" Click="FormatButton_Click" Width="30" Padding="0,4" Margin="0,0,4,0" FontStyle="Italic" ToolTip="斜体 *文字*"/>
                                <Button Content="S" Tag="strike" Click="FormatButton_Click" Width="30" Padding="0,4" Margin="0,0,4,0" ToolTip="删除线 ~~文字~~"/>
                                <Button Content="`" Tag="code" Click="FormatButton_Click" Width="30" Padding="0,4" Margin="0,0,4,0" ToolTip="行内代码 `文字`"/>
                                <Button Content="链接" Tag="link" Click="FormatButton_Click" Padding="8,4" Margin="0,0,4,0" ToolTip="链接 [文字](https://)"/>
                                <Button Content="H" Tag="heading" Click="FormatButton_Click" Width="30" Padding="0,4" Margin="0,0,4,0" FontWeight="Bold" ToolTip="标题 # "/>
                                <Button Content="•" Tag="list" Click="FormatButton_Click" Width="30" Padding="0,4" Margin="0,0,4,0" ToolTip="列表 - "/>
                            </StackPanel>
                            <TextBox x:Name="DisplayBox"
                                     TextChanged="Text_Changed"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="76"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"/>
                            <TextBlock Style="{StaticResource Hint}" Text="支持 **加粗** *斜体* `代码` ~~删除线~~ [链接](url)、# 标题、- 列表"/>

                            <TextBlock Text="触发后打开（可选）" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                            <TextBox x:Name="ActionBox" TextChanged="Text_Changed"/>
                            <TextBlock Style="{StaticResource Hint}" Text="触发时同时打开一个或多个网址 / 文件夹 / 文件（如 https://…、D:\logs、D:\a.txt），多个用 ; 分隔，留空则不打开"/>

                            <TextBlock Text="显示时长（秒）" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="DurationSlider" Grid.Column="0" Minimum="1" Maximum="120" ValueChanged="DurationSlider_ValueChanged" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="DurationBox" Grid.Column="1" Width="54" TextAlignment="Center" LostFocus="DurationBox_LostFocus" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text=" 秒" FontSize="13" VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="显示大小" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                            <ComboBox x:Name="SizeCombo" SelectionChanged="SizeCombo_SelectionChanged"/>

                            <TextBlock Text="提示条颜色" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="ColorCombo" Width="150" SelectionChanged="ColorCombo_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Rectangle x:Name="ColorPreview" Width="22" Height="22" RadiusX="6" RadiusY="6" Margin="10,0,0,0" VerticalAlignment="Center" Stroke="{DynamicResource Theme.Border}"/>
                            </StackPanel>

                            <Button Content="▶ 测试这条提示" Margin="0,18,0,0" HorizontalAlignment="Left" Click="TestButton_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="事件记录">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="清空记录" Click="ClearEvents_Click"/>
                        <TextBlock Text="最多保留 500 条，新的在最上方" FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <ListView x:Name="EventList" Grid.Row="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="时间" Width="150" DisplayMemberBinding="{Binding Time, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                                <GridViewColumn Header="规则" Width="160" DisplayMemberBinding="{Binding RuleName}"/>
                                <GridViewColumn Header="来源" Width="90" DisplayMemberBinding="{Binding Source}"/>
                                <GridViewColumn Header="匹配内容" Width="440" DisplayMemberBinding="{Binding MatchedText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <TabItem Header="常规设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="外观" Style="{StaticResource Section}"/>
                    <TextBlock Text="主题" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeCombo_SelectionChanged"/>
                    <TextBlock Style="{StaticResource Hint}" Text="明亮 / 夜间 / 薄荷 / 暮紫，切换后设置界面与提示条即时换肤"/>

                    <TextBlock Text="提示栏位置" Style="{StaticResource Label}" Margin="0,16,0,4"/>
                    <ComboBox x:Name="PositionCombo" SelectionChanged="PositionCombo_SelectionChanged"/>
                    <TextBlock Style="{StaticResource Hint}" Text="悬浮提示栏出现在屏幕的位置，多条提示会依次堆叠"/>

                    <TextBlock Text="行为" Style="{StaticResource Section}"/>
                    <TextBlock Text="默认显示时长（秒）" Style="{StaticResource Label}"/>
                    <TextBox x:Name="DefaultDurationBox" LostFocus="DefaultDurationBox_LostFocus"/>

                    <TextBlock Text="检测间隔（毫秒）" Style="{StaticResource Label}" Margin="0,16,0,4"/>
                    <ComboBox x:Name="PollCombo" SelectionChanged="PollCombo_SelectionChanged"/>

                    <TextBlock Text="触发冷却（秒）" Style="{StaticResource Label}" Margin="0,16,0,4"/>
                    <TextBox x:Name="CooldownBox" LostFocus="CooldownBox_LostFocus"/>
                    <TextBlock Style="{StaticResource Hint}" Text="同一条规则两次触发之间的最短间隔，避免反复弹窗"/>

                    <TextBlock Text="浏览器检测" Style="{StaticResource Section}"/>
                    <TextBlock Text="浏览器进程名" Style="{StaticResource Label}"/>
                    <TextBox x:Name="BrowserProcessesBox" LostFocus="BrowserProcessesBox_LostFocus"/>
                    <TextBlock Style="{StaticResource Hint}" Text="用于识别“浏览器标签”来源，多个进程名用 ; 分隔，例如 chrome;msedge;firefox"/>

                    <TextBlock Text="CDP 调试端口" Style="{StaticResource Label}" Margin="0,16,0,4"/>
                    <TextBox x:Name="CdpPortsBox" LostFocus="CdpPortsBox_LostFocus"/>
                    <TextBlock Style="{StaticResource Hint}" Text="浏览器需以 --remote-debugging-port 启动（如 Chrome=9222、Edge=9223）。本程序据此在『新打开标签页』时触发一次。多个端口用 ; 分隔"/>
                    <TextBlock x:Name="CdpStatusText" FontSize="12" Foreground="{DynamicResource Theme.Accent}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                    <TextBlock Text="系统" Style="{StaticResource Section}"/>
                    <CheckBox x:Name="AutoStartCheck" Content="开机自动启动（登录后最小化到托盘）" Click="AutoStartCheck_Click"/>
                    <CheckBox x:Name="PausedCheck" Content="暂停所有监控" Margin="0,10,0,0" Click="PausedCheck_Click"/>

                    <TextBlock Margin="0,22,0,0" FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}" TextWrapping="Wrap"
                               Text="配置自动保存。配置文件位置：%APPDATA%\TextBanner\config.json"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
